DB_USER=root
DB_PASSWORD=root
DB_NAME=chomage-go
DB_HOST=db
BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
PORT_DB=5432
PORT_BACKEND=4000
PORT_FRONTEND=3000
PORT_PUBLIC=3000

# Envoi des e-mails (verification d'adresse, notification de candidature).
# Sans SMTP_HOST, les messages sont seulement journalises et le lien de
# verification apparait dans les logs du backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GeoEmploi <no-reply@geoemploi.fr>
# Repertoire optionnel ou une copie HTML de chaque message est deposee.
MAIL_OUTBOX_DIR=
